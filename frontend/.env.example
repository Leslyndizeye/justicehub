# Copy to frontend/.env and start Vite from the frontend directory.
# Frontend only. Vite exposes VITE_* values to the browser.
# Use the backend base URL without /api or a trailing slash.
# In development Vite proxies /api to this URL; production browsers use it directly.
VITE_API_URL=http://localhost:4000

# Firebase is currently configured in components/firebaseConfig.js.
# Do not add Groq or privileged Supabase keys here.
