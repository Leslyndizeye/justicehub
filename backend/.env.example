# Copy to backend/.env and start the backend from the backend directory.
# Required: get these values from the project owner or service dashboards.
SUPABASE_URL=
SUPABASE_ANON_KEY=
GROQ_API_KEY=

# Optional: defaults shown below. FRONTEND_URL is a single origin.
GROQ_MODEL=openai/gpt-oss-120b
# Built-in browser search (no separate search key). Set false to disable.
GROQ_WEB_SEARCH=true
FRONTEND_URL=http://localhost:5173
PORT=4000
