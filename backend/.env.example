# Copy to backend/.env and start the backend from the backend directory.
# Required: get these values from the project owner or service dashboards.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for the protected API and private memory; never put this key in frontend/.env.
# Apply both migrations/20261009_user_memories.sql and migrations/20261010_private_api_tables.sql before public launch.
SUPABASE_SERVICE_ROLE_KEY=
# Must match the Firebase project used for sign-in.
FIREBASE_PROJECT_ID=ireme-30164
GROQ_API_KEY=

# Optional: defaults shown below. FRONTEND_URL accepts comma-separated frontend URLs.
# Set this in Render's Environment settings too; your local .env is not deployed.
# These models have free-plan access. Keep the Groq account on Free in Settings > Billing.
# Environment settings do not prevent charges if the account is upgraded to a paid plan.
GROQ_MODEL=openai/gpt-oss-120b
# Try this model if the main model is rate-limited. Use none to disable fallback.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Reasoning effort on GPT-OSS: low, medium, or high. Higher settings can use more tokens.
GROQ_REASONING_EFFORT=medium
# Search is performed separately. Keep Tavily on Researcher/Free with pay-as-you-go disabled.
# Create a free key at https://app.tavily.com and store it only in backend/.env.
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Account-wide credit ceiling, including other keys/uses. Clamped to 0..1000.
TAVILY_MONTHLY_LIMIT=900
# Optional search backup. Keep the Groq account on Free; this uses its token quota.
# A separate research request receives only the public search query, not chat history.
GROQ_SEARCH_FALLBACK=true
GROQ_SEARCH_MODEL=openai/gpt-oss-20b
# Normal answer generation disables built-in tools even if an old .env says true.
GROQ_WEB_SEARCH=false
FRONTEND_URL=http://localhost:5173
PORT=4000

# Optional natural read-aloud. Create a Free-tier key with billing DISABLED.
# Keep the key only here and in Render, never in frontend variables or chat.
GEMINI_API_KEY=
# Set true only after checking that this key's Google project has no billing account.
# The app cannot verify or change Google's billing tier; a paid key can incur charges.
GEMINI_SPEECH_FREE_TIER=false
# Application cap per UTC day and process (0 disables new generations; maximum 100).
# Google's actual project quotas may be lower. No automatic paid fallback or retries.
GEMINI_SPEECH_DAILY_LIMIT=30
